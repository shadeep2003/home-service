# Allow only application sources and safe Docker support files into the context.
**
!composer.json
!composer.lock
!artisan
!phpunit.xml
!app/
!app/**
!bootstrap/
!bootstrap/**
!config/
!config/**
!database/
!database/**
!resources/
!resources/**
!routes/
!routes/**
!public/
!public/**
!tests/
!tests/**
!docker/
!docker/**
# Defense in depth: never copy runtime state or secrets, even under allowed paths.
**/.env
**/.env.*
**/.git
**/*.pem
**/*.key
**/*.sql
**/*.sqlite
**/*.sqlite3
**/auth.json
bootstrap/cache/**
public/storage
public/storage/**
public/uploads/**
public/hot
docker/*.env
